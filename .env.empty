# ============================================================
# Configuration for the UVP6 automation scripts
# Copy this file to ".env" and fill in the values before first use.
# The .env file contains credentials: it is gitignored and must
# NEVER be committed.
# ============================================================

# Serial COM port number (number only, e.g. 3 for COM3)
COM_PORT=

# IP address of this computer's Ethernet port connected to the UVP6
# (OctOS launch arg #2, also used by the sdlist command). E.g. 192.168.0.1
# This is the "Host IP (this computer)" shown in the OctOS startup banner.
HOST_IP=

# IP address of the UVP6 instrument (OctOS launch arg #3)
# This is the "UVP6 IP" shown in the OctOS startup banner.
UVP_IP=

# Serial baudrate (bits/s). Must match the UVP6 configuration.
BAUDRATE=38400

# UDP port used by OctOS (launch arg #5). Typically 49152.
OCTOS_PORT=49152

# Absolute path to the OctOS root folder (containing bin/, filemanager/, etc.)
# Use \ or / - do not use quotes
OCTOS_DIR=

# Delay (seconds) between each command sent to OctOS
# Increase if commands fail due to insufficient time
WAIT_BETWEEN_COMMANDS=3

# Seconds to wait for UVP6 data lines (LPM_DATA/BLACK_DATA) after OctOS starts.
# If no data arrives within this time, a stop (and reboot if needed) is sent
# before proceeding.
DATA_WAIT_TIMEOUT=15

# Timeout (seconds) for one sdlist attempt. A healthy tree.txt transfer takes
# ~15-20s, so keep this short: a hung sdlist (no [SDLIST] EXIT) is then caught
# quickly and retried in-session instead of stalling. Also never waits past
# MAX_DOWNLOAD_MINUTES.
SDLIST_TIMEOUT=120

# Timeout (seconds) for the sddump command (download)
# Thousands of small files can take hours: adjust to the expected volume
SDDUMP_TIMEOUT=14400

# Timeout (seconds) for the sdformat command (cleanup)
SDFORMAT_TIMEOUT=180

# Number of sdlist retries within the SAME OctOS session (no reboot between
# tries). The tree.txt listing is a lossy UDP transfer that often reports
# "file transmission was incomplete" and needs several attempts to succeed;
# re-sending sdlist on the same live session is much cheaper than a full
# stop/reboot cycle. 10 is a safe default; reduce to 0 to disable.
SDLIST_SESSION_RETRIES=10

# Pause (seconds) before each sdlist retry. Each sdlist re-powers the
# Processing Unit; retrying too fast can hit "PU is powered, but the READY
# signal wasn't set". 10s lets the PU settle between attempts.
SDLIST_RETRY_DELAY=10

# Number of sddump retries within the SAME OctOS session.
# When sddump reports file transfer failures, it is re-run immediately (still
# within the same stop/sdlist session) up to this many extra times, so each
# retry only re-downloads the remaining failed files without restarting the
# instrument. 5 is a safe default; reduce to 0 to disable.
SDDUMP_SESSION_RETRIES=5

# Maximum wall-clock time (minutes) the instrument may stay stopped for a
# download session. Once reached, sdlist/sddump stop retrying, the UVP6 is
# rebooted (acquisition resumes) and the run ends cleanly - partial progress
# is kept and the next run continues where it left off. This caps how much
# acquisition time each run can cost on a slow/lossy link. 0 = unlimited.
MAX_DOWNLOAD_MINUTES=28

# Number of full OctOS session attempts (stop → sdlist → sddump → reboot) on
# hard failures (e.g. socket/connection errors). 1 = no retry.
MAX_RETRIES=3

# Delay (seconds) between full-session retry attempts
RETRY_DELAY=10

# Write raw OctOS output to separate octos_output_*.log files (true/false).
# Useful for debugging, slow on large sessions.
OCTOS_OUTPUT_LOG=false

# ============================================================
# SFTP upload (requires the Posh-SSH module, see HOWTO)
# ============================================================

# SFTP server hostname (e.g. sftp.example.org)
SFTP_HOST=

# SFTP username
SFTP_USER=

# SFTP port (standard SFTP is 22; custom ports are supported)
SFTP_PORT=22

# SFTP password
# NOTE: stored in plain text - keep this file out of git and restrict
# its NTFS permissions to the account running the scheduled tasks.
SFTP_PASSWORD=

# Remote directory on the SFTP server (files are uploaded under this path)
SFTP_REMOTE_DIR=
